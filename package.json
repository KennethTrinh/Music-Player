{
  "name": "phaze-vocoder",
  "version": "1.0.0",
  "description": "A phase vocoder for the browser",
  "type": "module",
  "main": "dist/phase-vocoder.js",
  "files": [
    "dist/phase-vocoder.js",
    "README.md"
  ],
  "scripts": {
    "build-main": "esbuild --bundle --format=iife src/main.js --outfile=dist/bundle.js",
    "build-equalizer": "esbuild --bundle --format=iife src/equalizer.js --outfile=dist/equalizer.js",
    "build-audio-worklet": "esbuild --bundle --format=iife src/phase-vocoder.js --outfile=dist/phase-vocoder.js",
    "build-pghi-worklet": "esbuild --bundle --format=iife src/pghi-vocoder.js --outfile=dist/pghi-vocoder.js",
    "build-keycnn-worker": "esbuild --bundle --format=iife --minify src/keycnn-worker.js --outfile=dist/keycnn-worker.js",
    "build-min": "esbuild --bundle --format=iife --minify src/phase-vocoder.js --outfile=dist/phase-vocoder.min.js",
    "watch-main": "esbuild --bundle --format=iife --sourcemap --watch=forever src/main.js --outfile=dist/bundle.js",
    "watch-equalizer": "esbuild --bundle --format=iife --sourcemap --watch=forever src/equalizer.js --outfile=dist/equalizer.js",
    "watch-audio-worklet": "esbuild --bundle --format=iife --sourcemap --watch=forever src/phase-vocoder.js --outfile=dist/phase-vocoder.js",
    "watch-pghi-worklet": "esbuild --bundle --format=iife --sourcemap --watch=forever src/pghi-vocoder.js --outfile=dist/pghi-vocoder.js",
    "generate-manifest": "node scripts/generate-music-manifest.js",
    "build": "npm run generate-manifest && npm run build-main && npm run build-equalizer && npm run build-audio-worklet && npm run build-pghi-worklet && npm run build-keycnn-worker",
    "watch": "npm-run-all --parallel watch-main watch-equalizer watch-audio-worklet watch-pghi-worklet",
    "start": "npx http-server -c-1",
    "test:browser": "node test/browser/playback.test.js",
    "test:memory": "node test/browser/memory.test.js",
    "test": "node test/pghi.test.js && node test/keycnn.test.js && node test/key-label.test.js",
    "publish": "npm run build-audio-worklet && npm run build-min && npm publish"
  },
  "keywords": [
    "phase",
    "vocoder",
    "pitch",
    "time",
    "stretch"
  ],
  "author": "Ken",
  "dependencies": {
    "fft.js": "^4.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5"
  }
}
